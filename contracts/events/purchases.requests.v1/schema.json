{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartstock.local/contracts/events/purchases.requests.v1/schema.json",
  "title": "Purchases requests v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "type", "version", "occurred_at", "payload"],
  "properties": {
    "request_id": { "$ref": "#/$defs/id" },
    "type": { "enum": ["get_need", "list_needs", "list_offers", "get_order", "create_draft", "decide_order", "get_overview"] },
    "version": { "const": 1 },
    "occurred_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "payload": { "type": "object" }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "get_overview" },
        "payload": { "type": "object", "additionalProperties": false }
      }
    },
    {
      "properties": {
        "type": { "const": "get_need" },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["event_id"],
          "properties": { "event_id": { "$ref": "#/$defs/id" } }
        }
      }
    },
    {
      "properties": {
        "type": { "enum": ["list_needs", "list_offers"] },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["sku", "limit", "cursor"],
          "properties": {
            "sku": { "$ref": "#/$defs/id" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
            "cursor": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "get_order" },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["order_id"],
          "properties": { "order_id": { "$ref": "#/$defs/id" } }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "create_draft" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["order_id", "need_event_id", "offer_id", "quantity"],
          "properties": {
            "order_id": { "$ref": "#/$defs/id" },
            "need_event_id": { "$ref": "#/$defs/id" },
            "offer_id": { "$ref": "#/$defs/id" },
            "quantity": { "$ref": "#/$defs/quantity" }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "decide_order" },
        "payload": {
          "type": "object", "additionalProperties": false,
          "required": ["order_id", "expected_revision", "decision", "actor_id"],
          "properties": {
            "order_id": { "$ref": "#/$defs/id" },
            "expected_revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
            "decision": { "enum": ["APPROVE", "REJECT"] },
            "actor_id": { "$ref": "#/$defs/id" }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "quantity": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
  }
}
